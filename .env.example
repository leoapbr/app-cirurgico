# Copie para .env.local e preencha. NUNCA commite .env.local.
# Variáveis NEXT_PUBLIC_* vão para o navegador: só coloque aqui o que pode ser público.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente servidor (Vercel > Settings > Environment Variables). Opcional na fatia A.
# sandbox = não envia e-mail, só registra no log. live = envia via Resend.
MAIL_MODE=sandbox
RESEND_API_KEY=
MAIL_FROM=
# Domínios autorizados a receber e-mail no protótipo (destinatários de teste), separados por vírgula.
MAIL_ALLOWED_DOMAINS=

# Testes de banco (local/CI). Precisa de um Postgres 15+ acessível.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
